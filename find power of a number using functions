#include<stdio.h>
int power(int x,int y);
int power(int x,int y)
{
   int i,p=1;
   for(i=1;i<=y;i++)
   {
      p=p*x;
   }
   return p;
}
int main ()
{
   int x,y,z;
   printf("enter the value of x,y");
   scanf("%d%d",&x,&y);
        z=power(x,y);
   printf("value of power is :%d",z);
   return 0;
}
