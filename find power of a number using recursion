#include<stdio.h>
int power(int x,int y);
int power(int x,int y)
{
   if(y==0)
   {
      return 1;
   }
   else
   {
      return x*power(x,y-1);
   }
}
int main()
{
   int x,y;
   printf("Enter the value of x,y");
   scanf("%d%d",&x,&y);
   if(x>0 && y>0)
   {
      printf("%d\n",power(x,y));
   }
   else
   {
      printf("invalid");
   }
   return 0;
}
