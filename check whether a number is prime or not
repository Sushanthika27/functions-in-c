#include<stdio.h>
#include<math.h>
int prime(int n);
int prime(int n)
{
   int i,f=0;
   for(i=2;i<pow(n,0.5);i++)
   {
      if(n%i==0)
      {
         f=1;
         break;
      }
   }
   if(f==0)
   {
      return 1;
   }
   else
   {
         return 0;
   }
}
int main()
{
      int res,n;
      printf("Enter the value of n");
      scanf("%d",&n);
      res = prime(n);
      if(res==0)
      {
         printf("\n Not A Prime Number\t");
      }
      else
      {
         printf("\n Prime Number\t");
      }
      printf("%d\n",res);
      return 0;
}
