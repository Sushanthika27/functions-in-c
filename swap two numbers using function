
#include<stdio.h>
void swap(int *a,int *b);
void swap(int *a,int *b)
{
  int temp;
  temp=*a;
  *a=*b;
  *b=temp;
   printf("after swap:a=%d,b=%d\n",*a,*b);
}
int main()
{
   int a,b;
   printf("enter the value of a,b");
   scanf("%d%d",&a,&b);
   printf(" before swap :a=%d,b=%d\n",a,b);
   swap(&a,&b);
   return 0;
}
