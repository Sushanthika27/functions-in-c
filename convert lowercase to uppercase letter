#include<stdio.h>
char low_to_up(char ch);
char low_to_up(char ch)
{
   char res;
   if(ch>='a')
   {
      res=ch-32;
   }
   else
   {
      res=ch;
   }
   return res;
}
int main()
{
   char ch,res;
   printf("enter a character:");
   scanf("%c",&ch);
   res=low_to_up(ch);
   printf("%c",res);
   return 0;
}
